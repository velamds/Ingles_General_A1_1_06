ear\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"close to something\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\"> I am sitting near the library. </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "early"}, {"type": "definition", "content": "before the expected/scheduled time"}, {"type": "part_speech", "content": " (adjective)"}, {"type": "example", "content": "Example: Am I early?"}, {"type": "audio", "content": "engenn2le06ob04aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when on the telephone."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to end"}, {"type": "definition", "content": "to finish"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I am ending this call right now."}, {"type": "audio", "content": "engenn2le06ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "safe"}, {"type": "definition", "content": "protected; not dangerous"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I'm leaving my apartment now and locking my door to be safe. "}, {"type": "audio", "content": "engenn2le06ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to wait"}, {"type": "definition", "content": "to stay where one is until something happens"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I am waiting."}, {"type": "audio", "content": "engenn2le06ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be"}, {"type": "definition", "content": "to exist or live"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  I am still looking for him."}, {"type": "audio", "content": "engenn2le06ob04aud0