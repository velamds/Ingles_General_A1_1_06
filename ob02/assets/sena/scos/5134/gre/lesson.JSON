{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "In the Park"}, {"type": "unit_name", "content": "Turn Left, Turn Right"}, {"type": "position", "content": 2}, {"type": "origin", "content": "scholar > Here and There > The Neighborhood"}, {"type": "lesson", "content": 6}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe places, neighborhoods and countries in communicative situations."}, {"type": "secondary_1", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level. "}, {"type": "secondary_3", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_4", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level. "}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_8", "content": "Understands key information in written texts about the communicative topics related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Asking For and Giving Directions"}, {"type": "describer", "content": "You use Wh- questions to ask for directions.<br/>To give directions, you use Imperatives and expressions like Go  <span class = \"italic\">straight ahead, Turn right</span> or <span class = \"italic\">Turn left</span>. You do not use a subject."}, {"type": "table", "content": "{\"rows\":\"2\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Asking for directions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Giving directions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where is ... ?<br/>Where do I find ... ?<br/>How do I get to ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Go straight ahead.<br/>Turn right/left.<br/>Walk across the bridge.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class = \"strong\">Andrew</span>: Excuse me, how do I get to the stadium?<br/><span class = \"strong\">Beth</span>: Go straight ahead."}, {"type": "example", "content": "<span class = \"strong\">Michael</span>: Where is the library?<br/><span class = \"strong\">Patrick</span>: It's right here. Go straight and turn left."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Things to Do in the City"}, {"type": "describer", "content": " There are many things you can do in a city. Read the chart below for a list of free time activities:"}, {"type": "table", "content": "{\"rows\":\"3\",\"columns\":\"3\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Inside\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Outside\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Place: <span class = \\\"italic\\\">I go to the ...</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"bakery<br/>restaurant<br/>swimming pool\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"stadium<br/>park<br/>square\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Activity: <span class = \\\"italic\\\">I like to ...</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"eat<br/>swim\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"run<br/>walk\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class = \"strong\">Peter</span>: What is there to do in the neighborhood?<br/><span class = \"strong\">Vanessa</span>: There are many restaurants near the park. We can walk to the park and then eat in a restaurant!"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "behind"}, {"type": "definition", "content": "to the back of something or someone"}, {"type": "part_speech", "content": "(preposition)"}, {"type": "example", "content": "Example: The bakery is on the street behind the swimming pool."}, {"type": "audio", "content": "engenn2le06ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to ask for directions."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "bridge"}, {"type": "definition", "content": "a structure that carries a road over water"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Turn left and walk across the bridge."}, {"type": "audio", "content": "engenn2le06ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "I'm not sure"}, {"type": "definition", "content": "I don't know"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: <span class = \"strong\">Vanessa</span>: Where is the bakery?  <span class = \"strong\">Peter</span>: I'm not sure."}, {"type": "audio", "content": "engenn2le06ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "in front of"}, {"type": "definition", "content": "ahead of something or someone"}, {"type": "part_speech", "content": "(preposition)"}, {"type": "example", "content": "Example: Let's ask the person in front of the store."}, {"type": "audio", "content": "engenn2le06ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be confused"}, {"type": "definition", "content": "to be unable to understand clearly"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Where's the bridge? Is it near the park? I'm confused."}, {"type": "audio", "content": "engenn2le06ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to be lost"}, {"type": "definition", "content": "to be unable to find your way"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I think we're lost. Let's ask someone."}, {"type": "audio", "content": "engenn2le06ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to give up"}, {"type": "definition", "content": "to stop trying"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Turn left, turn right \u2026 I give up!"}, {"type": "audio", "content": "engenn2le06ob02aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "under"}, {"type": "definition", "content": "at a level lower than something else; below"}, {"type": "part_speech", "content": "(preposition)"}, {"type": "example", "content": "Example: Let's go sit under a tree."}, {"type": "audio", "content": "engenn2le06ob02aud08"}]}, {"type": "background_image", "content": "engenn2le06ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "With a partner, think of another place to describe."}, {"type": "text", "content": "Ask and give directions to the new place."}, {"type": "text", "content": "Use a neighborhood map to draw the directions."}, {"type": "text", "content": "Check with your partner if the directions are correct."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I describe places in my neighborhood."}, {"type": "text", "content": "I ask and give directions."}, {"type": "text