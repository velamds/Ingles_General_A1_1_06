{"_data": [{"type": "metadata", "contents": [{"content": "In the Park", "type": "lesson_name"}, {"content": "What's That Sound?", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 6, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about people, their likes and dislikes, homes or countries in communicative situations.", "type": "primary"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_2"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_3"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_7"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Making Suggestions", "type": "heading"}, {"content": "You make suggestions to talk about possible or necessary things to do.<br/><br/>You use the following expression to <span class = \"italic\">make suggestions</span> or <span class = \"italic\">offer a helpful idea</span>:<br/>- You could ... (possible)<br/><br/>You use the following expression to make a <span class = \"italic\">strong suggestion</span> or <span class = \"italic\">recommendation</span>:<br/>- You should ... (necessary)<br/> ", "type": "describer"}, {"content": "<span class = \"strong\">Ann</span>: It's sunny and warm outside. We could go to the park. <br/><span class = \"strong\">Bob</span>: Great idea!", "type": "example"}, {"content": "<span class = \"strong\">Ann</span>: There are dark clouds in the sky. It's about to rain. You should bring an umbrella.<br/><span class = \"strong\">Charlie</span>: Yes, mom!", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Saying Where Things are in a City", "type": "heading"}, {"content": "You use prepositions of place like <span class = \"italic\">at, in</span> and <span class = \"italic\">on</span> to talk about where things are.", "type": "describer"}, {"content": "Use <span class = \"strong\">at</span> when you talk about things <span class = \"strong\">at</span> a location.<br/>Use <span class = \"strong\">in</span> when you talk about things <span class = \"strong\">in</span> a location.<br/>Use <span class = \"strong\">on</span> when you talk about things <span class = \"strong\">on</span> a location.", "type": "text"}, {"content": "{\"rows\":\"4\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Preposition\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"at\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">at home<br/>at the dry cleaners\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"in\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">in the kitchen<br/>in the office\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"on\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">on the street<br/>on ... Street/Avenue<br/>on the way\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "<span class = \"strong\">Ann</span>: Where can someone fix my jacket?<br/><span class = \"strong\">Bob</span>: At the dry cleaners.<br/><span class = \"strong\">Anne</span>: Where is it?<br/><span class = \"strong\">Bob</span>: It's on Mercer Street.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "cool", "type": "name"}, {"content": "a day that is not too hot and not too cold", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The weather is perfect today. It's quite cool.", "type": "example"}, {"content": "engenn2le06ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about the weather.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "sound", "type": "name"}, {"content": "something you hear; noise", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: What's that sound? Can you hear it?", "type": "example"}, {"content": "engenn2le06ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "strange", "type": "name"}, {"content": "unusual; not normal", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: That's a strange sound! What's that? ", "type": "example"}, {"content": "engenn2le06ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to sightsee", "type": "name"}, {"content": "to walk around and see things like attractions and monuments", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: My friends are coming from out of town. Let's go sightseeing!", "type": "example"}, {"content": "engenn2le06ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "warm", "type": "name"}, {"content": "a day that is comfortable (not cold, almost hot)", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: It's really warm today. Let's go to the beach.", "type": "example"}, {"content": "engenn2le06ob09aud05", "type": "audio"}]}, {"content": "engenn2le06ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Talk about the weather with your partner.", "type": "text"}, {"content": " Make suggestions of what activities you can do in each kind of weather.", "type": "text"}, {"content": "Exchange roles. Complete the table.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Weather\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Activity Suggestion<br/> (Me)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Activity Suggestion<br/> (My Partner)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"sunny\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rainy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"cold\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about the weather.", "type": "text"}, {"content": "I make suggestions about activities.", "type": "text"}, {"content": "I listen to and write suggestions for activities.", "type": "text"}]}], "la