{"_data": [{"type": "metadata", "contents": [{"content": "In the Park", "type": "lesson_name"}, {"content": "The Ripped Jacket", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 6, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe places, neighborhoods and countries in communicative situations.", "type": "primary"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_1"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_3"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_4"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_7"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Making Suggestions", "type": "heading"}, {"content": "You make suggestions to talk about possible things to do.<br/>You use the following expressions with modals to make suggestions:<br/>- You could ...<br/>- You should ...<br/>- You might want to ...", "type": "describer"}, {"content": "<span class = \"strong\">Bob</span>: My friends are coming to visit this weekend.<br/><span class = \"strong\">Greg</span>: Great! You could take them to a museum.", "type": "example"}, {"content": "<span class = \"strong\">Sue</span>: I don't know where to go tonight. What do you suggest?<br/><span class = \"strong\">Drew</span>: You should go to a show. You might want to listen to this new band!", "type": "example"}, {"content": "<span class = \"strong\">Sue</span>: It's getting cold now. <br/> <span class = \"strong\">Bob</span>: You might want to put on your jacket.", "type": "example"}, {"content": "<span class = \"strong\">Carol</span>: Why are you wearing a coat? <br/> <span class = \"strong\">Rob</span>: It's cold out. You should wear a coat, too.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "dry cleaner", "type": "name"}, {"content": "a place where someone cleans your clothes and fixes them", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Where is the dry cleaner? I need to fix this jacket.", "type": "example"}, {"content": "engenn2le06ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear about places in a city. ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "it's getting cold", "type": "name"}, {"content": "the weather is changing from warm to cold", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: It's getting cold. Can you pass me your jacket?", "type": "example"}, {"content": "engenn2le06ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "It's on the way", "type": "name"}, {"content": "when a place is in the same direction", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I can bri